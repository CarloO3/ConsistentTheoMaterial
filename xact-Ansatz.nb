Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"DefConstantSymbol", "[", "MM", "]"}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "TheOneForMassiveSpin1", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GaugeS0", "[", "0", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"IndexRuleDelayed", "[", 
     RowBox[{
      RowBox[{"Sp", "[", 
       RowBox[{"LI", "[", "1", "]"}], "]"}], ",", "0"}], "]"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GaugeS1", "[", "0", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"IndexRuleDelayed", "[", 
     RowBox[{
      RowBox[{"Vp", "[", 
       RowBox[{
        RowBox[{"LI", "[", "1", "]"}], ",", "s_"}], "]"}], ",", 
      RowBox[{
       RowBox[{"MM", "*", 
        RowBox[{"xi", "[", "s", "]"}]}], "+", 
       RowBox[{
        RowBox[{"1", "/", "MM"}], "*", 
        RowBox[{
         RowBox[{"PD", "[", "s", "]"}], "@", 
         RowBox[{
          RowBox[{"PD", "[", "r", "]"}], "@", 
          RowBox[{"xi", "[", 
           RowBox[{"-", "r"}], "]"}]}]}]}]}]}], "]"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GaugeS2", "[", "0", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"IndexRuleDelayed", "[", 
     RowBox[{
      RowBox[{"Hp", "[", 
       RowBox[{
        RowBox[{"LI", "[", "1", "]"}], ",", "s_", ",", "m_"}], "]"}], ",", 
      RowBox[{"Evaluate", "[", 
       RowBox[{
        RowBox[{"2", "*", 
         RowBox[{"Symmetrize", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"PD", "[", "s", "]"}], "@", 
            RowBox[{"xi", "[", "m", "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", "m"}], "}"}]}], "]"}]}], "//", 
        "CollectTensors"}], "]"}]}], "]"}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.979443102880849*^9, 3.9794431253524723`*^9}, {
  3.979703844630274*^9, 3.979703930663231*^9}, {3.979704588101047*^9, 
