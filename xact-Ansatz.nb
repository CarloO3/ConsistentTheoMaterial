Cell[BoxData[
 RowBox[{
  RowBox[{"uponintTDIFF", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"perturbation", ",", "out1", ",", "out2", ",", "out3"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"perturbation", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Perturbation", "[", "expr", "]"}], "//", 
         "ExpandPerturbation"}], "//", 
        RowBox[{"ReplaceAll", "[", 
         RowBox[{
          RowBox[{"Perturbation", "[", 
           RowBox[{
            RowBox[{"g", "[", "x__", "]"}], ",", "y___"}], "]"}], ":>", "0"}],
          "]"}]}], "//", "CollectTensors"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"out1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"perturbation", "//", 
          RowBox[{"ReplaceAll", "[", 
           RowBox[{"GaugeS2", "[", "0", "]"}], "]"}]}], "//", 
         RowBox[{"ReplaceAll", "[", 
          RowBox[{"GaugeS1", "[", "0", "]"}], "]"}]}], "//", 
        RowBox[{"ReplaceAll", "[", 
         RowBox[{"GaugeS0", "[", "0", "]"}], "]"}]}], "//", 
       "CollectTensors"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"out2", "=", 
      RowBox[{
       RowBox[{"VarAction", "[", 
        RowBox[{"out1", ",", 
         RowBox[{"xi", "[", "m", "]"}]}], "]"}], "//", "CollectTensors"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"out3", "=", 
        RowBox[{
         RowBox[{"VarAction", "[", 
          RowBox[{"out1", ",", 
           RowBox[{"om", "[", "]"}]}], "]"}], "//", "CollectTensors"}]}], 
       ";"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"{", 
       RowBox[{"out2", ",", "out3"}], "}"}], "*)"}], "\[IndentingNewLine]", 
     "out2"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
