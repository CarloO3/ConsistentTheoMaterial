Cell[CellGroupData[{

Cell["\<\
Ancient/Obsolete IndComb2  --- takes a tensorial expression -> collect all \
the (independent-canonicalized) tensors -> provides the conditions for \
nullifying the corresponding coefficients + the coefficients.\
\>", "Subsubsection",
 CellChangeTimes->{{3.833359337238042*^9, 3.83335934045545*^9}, {
   3.889078301103563*^9, 3.889078304532285*^9}, {3.948791964771963*^9, 
   3.948792146028552*^9}, {3.954500727824464*^9, 3.954500753285753*^9}, {
