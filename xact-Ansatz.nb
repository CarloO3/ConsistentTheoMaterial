   3.961206651033324*^9}, {3.968288938479041*^9, 3.968288949541753*^9}, {
   3.968288981652468*^9, 3.9682890334001827`*^9}, {3.979443224044319*^9, 
   3.979443227808685*^9}, 
   4.002007026086954*^9},ExpressionUUID->"22a93f7d-1b4b-4f07-9ff7-\
aade0c634373"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Risolve", " ", "il", " ", "sistema", " ", "coef"}], "\[Equal]", 
    RowBox[{
    "0", " ", "per", " ", "annullare", " ", "la", " ", "variazione"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"IndComb2", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "expre", ",", "temp1", ",", "listconstants", ",", "Wrap", ",", 
       "allconstants", ",", "allconstantsX", ",", "matrix", ",", "matrix2", 
       ",", "indcond"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"allconstants", "=", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"ConstantSymbolsOf", "[", "expr", "]"}], ",", 
         RowBox[{"dimM", "|", "X"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"allconstantsX", "=", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"ConstantSymbolsOf", "[", "expr", "]"}], ",", "dimM"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"temp1", "=", 
       RowBox[{"expr", "//", 
        RowBox[{
         RowBox[{"CollectTensors", "[", 
          RowBox[{"#", ",", 
           RowBox[{"RemoveTensorWrapper", "\[Rule]", "False"}]}], "]"}], 
         "&"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", "temp1", "]"}], ";"}], "\[IndentingNewLine]", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"listconstants", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@", "temp1"}], ")"}], "//", 
           RowBox[{"ReplaceAll", "[", 
            RowBox[{"TensorWrapper", "\[RuleDelayed]", "Wrap"}], "]"}]}], "//", 
          RowBox[{"ReplaceAll", "[", 
           RowBox[{
            RowBox[{"Wrap", "[", "x___", "]"}], "\[RuleDelayed]", "1"}], 
           "]"}]}], "//", "DeleteDuplicates"}], "//", "FullSimplify"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", "listconstants", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "allconstants", "]"}], ";"}], 
       "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"indcond", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"listconstants", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "==", "0"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "listconstants", "]"}]}], "}"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"matrix", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{
             RowBox[{"listconstants", "[", 
              RowBox[{"[", "ii", "]"}], "]"}], ",", "allconstants"}], "]"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"ii", ",", "1", ",", 
             RowBox[{"Length", "[", "listconstants", "]"}]}], "}"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"matrix2", "=", 
         RowBox[{"matrix", "[", 
          RowBox[{"[", 
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Position", "[", 
               RowBox[{"#", ",", 
                RowBox[{"Except", "[", 
                 RowBox[{"0", ",", 
                  RowBox[{"_", "?", "NumericQ"}]}], "]"}], ",", "1", ",", 
                "1"}], "]"}], "&"}], "/@", 
             RowBox[{"Last", "@", 
              RowBox[{"QRDecomposition", "@", 
               RowBox[{"Transpose", "@", "matrix"}]}]}]}], "]"}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"indcond", "=", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{"matrix2", ".", "allconstants"}], "]"}]}], ";"}], 
       "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"indcond", ",", "allconstants"}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.821939241435851*^9, 3.821939322372671*^9}, {
   3.821939726020691*^9, 3.821939738556062*^9}, {3.821945017605256*^9, 
   3.821945041711436*^9}, {3.821945105907037*^9, 3.821945163313035*^9}, {
